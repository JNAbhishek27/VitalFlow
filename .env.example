# SMARTSPECTRA_API_KEY: Required for genuine Presage SmartSpectra SDK sessions in Electron.
# Read exclusively in the Electron main process (electron/main.ts).
# Never prefix with VITE_ or expose inside client/renderer browser bundles.
SMARTSPECTRA_API_KEY="YOUR_PRESAGE_SMARTSPECTRA_API_KEY"

# SMARTSPECTRA_DIAGNOSTICS: Optional "1" to enable verbose SDK IPC diagnostic logs in Electron.
SMARTSPECTRA_DIAGNOSTICS="0"

# GEMINI_API_KEY: Unused by VITALFLOW; retained for AI Studio environment compatibility.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
